{
  "name": "ts-kicad",
  "scripts": {
    "start": "bun cli.ts",
    "typecheck": "bun node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "bun test src"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "fast-xml-parser": "^5.11.1",
    "@tscircuit/math-utils": "^0.0.38",
    "@tscircuit/schematic-trace-solver": "^0.0.187",
    "calculate-elbow": "^0.0.13",
    "connectivity-map": "^1.0.0",
    "flatbush": "^4.6.2",
    "graphics-debug": "^0.0.100"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "typescript": "5.9.3"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./components/index.ts",
    "./components/*": "./components/*.ts",
    "./helpers": "./src/helpers.ts",
    "./power": "./src/power.ts",
    "./footprints/*": "./footprints/*.ts"
  },
  "bin": {
    "ts-kicad": "./cli.ts"
  },
  "version": "0.1.0",
  "description": "TypeScript circuits, native KiCad libraries, and checked schematic export",
  "engines": {
    "bun": ">=1.3.0"
  },
  "files": [
    "cli.ts",
    "src",
    "components",
    "footprints",
    "README.md",
    "THIRD_PARTY.md",
    "LICENSES",
    "examples/harness/README.md",
    "examples/harness/SOURCES.md",
    "examples/harness/download.ts",
    "examples/harness/package.json",
    "examples/harness/src"
  ]
}
